# Copy this file to .env.local and fill in the two values from Supabase:
# Dashboard > Project Settings > API Keys (and Data API for the URL).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Meta Pixel and Conversions API (Events Manager > your pixel > Settings).
# The pixel ID is public. The access token is secret: keep it here and in Vercel only, never in code.
NEXT_PUBLIC_META_PIXEL_ID=1819011455882416
META_CAPI_ACCESS_TOKEN=
# Optional: a code from Events Manager > Test events, to see server events live while testing. Remove it after.
META_TEST_EVENT_CODE=
